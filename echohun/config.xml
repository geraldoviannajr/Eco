<?xml version='1.0' encoding='utf-8'?>
<widget id="com.digitalsisgames.echos" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Echo</name>
    <description>Sample Apache Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Configurações iOS -->
    <platform name="ios">
        <preference name="deployment-target" value="12.0" />
        <preference name="code-sign-identity" value="geraldoviannajr@icloud.com" />
        <preference name="provisioning-profile" value="" />
        <preference name="development-team" value="" />
    </platform>
</widget>
